rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: Usuario autenticado con email corporativo
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email.matches('.*@ecomspain[.]com$');
    }
    
    // Función auxiliar: Obtener datos de perfil y rol
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }
    
    function isManager() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'MARKETING_MANAGER');
    }
    
    function canEditContent() {
      return isAuthenticated() && (
        getUserRole() == 'ADMIN' || 
        getUserRole() == 'MARKETING_MANAGER' || 
        getUserRole() == 'CONTENT_MANAGER' || 
        getUserRole() == 'PRODUCT_MANAGER' || 
        getUserRole() == 'DESIGNER'
      );
    }

    // Reglas para Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Reglas para Campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // Reglas para Contents y Variantes
    match /contents/{contentId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditContent();
      allow delete: if isAdmin();

      match /variants/{variantId} {
        allow read: if isAuthenticated();
        allow write: if canEditContent();
      }
    }

    // Reglas para Sources, Brands y Products
    match /sources/{sourceId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Reglas para Assets (Imágenes, Fotos y Archivos Multimedia)
    match /assets/{assetId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditContent();
      allow delete: if isAdmin();
    }

    // Reglas para Usage Records (FinOps)
    match /usage_records/{recordId} {
      allow read: if isManager();
      allow write: if false; // Solo backend con Admin SDK
    }

    // Reglas para Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo backend con Admin SDK
    }
  }
}
