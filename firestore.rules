rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: Usuario autenticado con email corporativo
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email.matches('.*@ecomspain[.]com$');
    }
    
    // Función auxiliar: Obtener rol desde user_roles/{uid} (Unificación de fuente de verdad)
    function getUserRole() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role;
    }

    // Función auxiliar: Obtener workspaceId del usuario desde user_roles/{uid} (predeterminado fallback)
    function getUserWorkspace() {
      let roleDoc = get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
      return roleDoc.keys().contains('workspaceId') ? roleDoc.workspaceId : 'default-ecomspain';
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }
    
    function isManager() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'MARKETING_MANAGER');
    }
    
    function canEditContent() {
      return isAuthenticated() && (
        getUserRole() == 'ADMIN' || 
        getUserRole() == 'MARKETING_MANAGER' || 
        getUserRole() == 'CONTENT_MANAGER' || 
        getUserRole() == 'PRODUCT_MANAGER' || 
        getUserRole() == 'DESIGNER' ||
        getUserRole() == 'EDITOR'
      );
    }

    function isSameWorkspace(resourceData) {
      return !resourceData.keys().contains('workspaceId') || resourceData.workspaceId == getUserWorkspace();
    }

    // Reglas para User Roles
    match /user_roles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reglas para Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Reglas para Campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && isSameWorkspace(resource.data);
      allow create: if isManager() && isSameWorkspace(request.resource.data);
      allow update: if isManager() && isSameWorkspace(resource.data) && isSameWorkspace(request.resource.data);
      allow delete: if isAdmin() && isSameWorkspace(resource.data);
    }

    // Reglas para Contents y Variantes
    match /contents/{contentId} {
      allow read: if isAuthenticated() && isSameWorkspace(resource.data);
      allow create: if canEditContent() && isSameWorkspace(request.resource.data);
      allow update: if canEditContent() && isSameWorkspace(resource.data) && isSameWorkspace(request.resource.data);
      allow delete: if isAdmin() && isSameWorkspace(resource.data);

      match /variants/{variantId} {
        allow read: if isAuthenticated() && isSameWorkspace(get(/databases/$(database)/documents/contents/$(contentId)).data);
        allow write: if canEditContent() && isSameWorkspace(get(/databases/$(database)/documents/contents/$(contentId)).data);
      }
    }

    // Reglas para Marketing Packages
    match /marketing_packages/{packageId} {
      allow read: if isAuthenticated() && isSameWorkspace(resource.data);
      allow create, update: if isManager() && isSameWorkspace(request.resource.data);
      allow delete: if isAdmin() && isSameWorkspace(resource.data);
    }

    // Reglas para Marketing Runs
    match /marketing_runs/{runId} {
      allow read: if isAuthenticated() && isSameWorkspace(resource.data);
      allow create, update: if canEditContent() && isSameWorkspace(request.resource.data);
      allow delete: if isAdmin() && isSameWorkspace(resource.data);
    }

    // Reglas para Sources, Brands y Products
    match /sources/{sourceId} {
      allow read: if isAuthenticated() && isSameWorkspace(resource.data);
      allow write: if isManager() && isSameWorkspace(request.resource.data);
    }
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Reglas para Assets (Imágenes, Fotos y Archivos Multimedia)
    match /assets/{assetId} {
      allow read: if isAuthenticated() && isSameWorkspace(resource.data);
      allow create: if canEditContent() && isSameWorkspace(request.resource.data);
      allow update: if canEditContent() && isSameWorkspace(resource.data) && isSameWorkspace(request.resource.data);
      allow delete: if isAdmin() && isSameWorkspace(resource.data);
    }

    // Reglas para Usage Records (FinOps)
    match /usage_records/{recordId} {
      allow read: if isManager();
      allow write: if false; // Solo backend con Admin SDK
    }

    // Reglas para Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo backend con Admin SDK
    }
  }
}
